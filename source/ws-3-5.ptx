<page>
    <paragraphs>
        <title>Try it Now!</title>
        <p>
            Solve the following equations. Make sure to check your solutions.
        </p>
        <p workspace="3.0in">
            (a) <m>1 - \frac{2}{x} = \frac{8}{x^2}</m>
        </p>
        <p workspace="3.0in">
            (b) <m>\frac{5}{3x-2} = \frac{7}{4x}</m>
        </p>
        <p workspace="3.0in">
            (c) <m>\frac{x}{x+6} = \frac{72}{x^2-36}+4</m>
        </p>
        <p workspace="3.0in">
            (d) <m>\frac{x+11}{x^2-5x+4} = \frac{5}{x-4}-\frac{3}{x-1}</m>
        </p>
    </paragraphs>
